.mcp.json
.obsidian/workspace*.json
.obsidian/cache
.trash/

# Dragon's Hoard: large binaries only (renders, atlas and particle PNGs are tracked as the finished product)
Assets/DragonsHoard/**/*.blend
Assets/DragonsHoard/**/*.blend1
Assets/DragonsHoard/*.zip

# Fantasy Creatures: Blender scenes and zip (rebuild with build_creatures.py); renders, sheets and exports are tracked
Assets/FantasyCreatures/**/*.blend
Assets/FantasyCreatures/**/*.blend1
Assets/FantasyCreatures/*.zip
Assets/FantasyCreatures/review/*.obj
Assets/FantasyCreatures/review/*_fast.png

# X/Twitter reference captures: third-party artwork, kept local only (repo is public). Notes, manifest and fetch script are tracked.
Assets/Reference-Captures/X/**/*.jpg
Assets/Reference-Captures/X/**/*.png
Assets/Reference-Captures/X/**/*.mp4
Assets/Reference-Captures/X/**/post.json

# YouTube video reference frames: third-party content, kept local only (repo is public). The breakdown note is tracked.
Assets/Reference-Captures/SyphoDev-AI-Workflow/**/*.jpg

# YouTube reference thumbnails (third-party, local only)
Assets/Reference-Captures/YouTube/*.jpg

# TikTok reference thumbnails (third-party, local only)
Assets/Reference-Captures/TikTok/*.jpg

# Third-party reference media (other games' screenshots, other designers' posts, tutorial videos, style
# reference boards): kept local only, same rule as the X captures (repo is public). Notes that embed them are tracked.
Projects/*/attachments/Ref *
Projects/*/attachments/shop-gauntlet/refs/
# blind critic pairs contain copies of the refs above
Projects/*/attachments/shop-gauntlet/blind/
Assets/*Style Reference.png
# Community drops (other creators' prompts, Roblox model/place files, Discord screenshots): local only
Assets/Community-Drops/
# Roblox game-page screenshots (Rubber Tower v5 research) and Holden's own picks of other games: local only
Assets/Reference-Captures/Roblox-Games/**/*.png
Assets/Reference-Captures/Holden-Picks/**/*.png
Assets/Reference-Captures/Holden-Picks/**/*.jpg

Assets/Reference-Captures/X/**/*.webp

# Retro stud style references (Trap Your Friends): third-party game thumbnails and devforum screenshots, local only
Assets/Reference-Captures/Retro-Stud/**/*.jpg
Assets/Reference-Captures/Retro-Stud/**/*.png
# Rubber Tower kit review sheets that composite third-party reference images (other games, X artists) next to our
# models ("model | reference"): local only, same rule as the refs themselves. Our own renders stay tracked.
Assets/Rubber-Tower-Valley-Kit/batch-*/Batch*_*.png
!Assets/Rubber-Tower-Valley-Kit/batch-*/Batch*_Diorama.png
!Assets/Rubber-Tower-Valley-Kit/batch-*/Batch*_Hub_*.png
!Assets/Rubber-Tower-Valley-Kit/batch-*/Batch*_Icons.png
!Assets/Rubber-Tower-Valley-Kit/batch-*/Batch*_SecretRoom_Cutaway.png
!Assets/Rubber-Tower-Valley-Kit/batch-*/Batch*_OnHeads_*.png
!Assets/Rubber-Tower-Valley-Kit/batch-*/Batch*_Gamepass_Options.png
Assets/Rubber-Tower-Valley-Kit/v4-styletest/Sheet_*.png
Assets/Reference-Captures/Titles/*.png
Assets/Reference-Captures/Titles/*.jpg
Assets/Reference-Captures/Titles/*.jpeg
